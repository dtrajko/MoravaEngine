// The opaque mesh material in a fragment stage (the PBR shaders and the G-buffer prepass): its values and toggles (push
// constants, editable in the Material Editor), its maps (set 1) and how both turn into the surface's inputs. One copy of
// this code keeps the prepass's normals and roughness identical to the ones the scene pass lights.
#ifndef MESH_MATERIAL_GLSLH
#define MESH_MATERIAL_GLSLH

#include "MaterialMaps.glslh"

layout (push_constant) uniform Material
{
	layout (offset = 64) vec3 AlbedoColor;
	float Metalness;
	float Roughness;

	// Toggles
	float RadiancePrefilter;
	float AlbedoTexToggle;
	float NormalTexToggle;
	float MetalnessTexToggle;
	float RoughnessTexToggle;

	// Offsets 104..123 (the whole block ends at 124 bytes; 128 is the minimum maxPushConstantsSize guaranteed by Vulkan)
	float TilingFactor;       // texture coordinate scale (0 is treated as 1)
	float EmissiveTexToggle;
	float AOTexToggle;
	float EmissiveIntensity;  // multiplies the emissive map (HDR values above 1 are fine)
	float MetalRoughPacked;   // 1: glTF metallicRoughness map (roughness in G, metalness in B); 0: both maps read from R
} u_MaterialUniforms;

// The texture coordinate with the material's tiling
vec2 MaterialTexCoord(vec2 texCoord)
{
	float tiling = u_MaterialUniforms.TilingFactor > 0.0 ? u_MaterialUniforms.TilingFactor : 1.0;
	return texCoord * tiling;
}

vec3 MaterialAlbedo(vec2 texCoord)
{
	return u_MaterialUniforms.AlbedoTexToggle > 0.5 ? texture(u_AlbedoTexture, texCoord).rgb : u_MaterialUniforms.AlbedoColor;
}

float MaterialMetalness(vec2 texCoord)
{
	bool packed = u_MaterialUniforms.MetalRoughPacked > 0.5;
	return u_MaterialUniforms.MetalnessTexToggle > 0.5 ? (packed ? texture(u_MetalnessTexture, texCoord).b : texture(u_MetalnessTexture, texCoord).r) : u_MaterialUniforms.Metalness;
}

float MaterialRoughness(vec2 texCoord)
{
	bool packed = u_MaterialUniforms.MetalRoughPacked > 0.5;
	float roughness = u_MaterialUniforms.RoughnessTexToggle > 0.5 ? (packed ? texture(u_RoughnessTexture, texCoord).g : texture(u_RoughnessTexture, texCoord).r) : u_MaterialUniforms.Roughness;
	return max(roughness, 0.05); // Minimum roughness of 0.05 to keep specular highlight
}

// The world-space shading normal: the vertex normal, or the normal map turned into world space by the tangent frame
vec3 MaterialNormal(vec2 texCoord, vec3 vertexNormal, mat3 worldNormals)
{
	vec3 normal = normalize(vertexNormal);
	if (u_MaterialUniforms.NormalTexToggle > 0.5)
	{
		normal = normalize(2.0 * texture(u_NormalTexture, texCoord).rgb - 1.0);
		normal = normalize(worldNormals * normal);
	}
	return normal;
}

#endif
