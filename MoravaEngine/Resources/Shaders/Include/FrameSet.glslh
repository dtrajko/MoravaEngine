// Set 0, per frame (fragment stage): scene data, environment maps, BRDF LUT, lights and shadow maps. See Include/FrameCamera.glslh:
// a shader that binds the per-frame descriptor set declares both, so its set 0 layout is identical to the PBR shaders'.
#ifndef FRAME_SET_GLSLH
#define FRAME_SET_GLSLH

// The textures here have no sampler of their own: each is declared as a texture (texture2D...) and then, under the same
// name, as a macro that pairs it with a shared sampler (Include/Samplers.glslh). Code reads them as before
// (texture(u_ShadowMap, ...)); the name of the binding (what the engine writes by name) stays the texture's.
#include "Samplers.glslh"

// Lights (EnvMapVulkanLights.h): the std140 layouts must match EnvMapVulkanLightsGPU byte for byte
const int MaxPointLights = 16;
const int MaxSpotLights = 16;

struct DirectionalLight
{
	vec3 Direction;  // towards the light
	float Intensity; // 0 when the sun is disabled
	vec3 Color;
	float Padding;
};

struct PointLight
{
	vec3 Position;
	float Intensity;
	vec3 Color;
	float Range;       // the light reaches exactly zero here
	float ShadowIndex; // the light's cube in u_PointShadowMaps, -1: no shadows
	float Padding0;
	float Padding1;
	float Padding2;
};

struct SpotLight
{
	vec3 Position;
	float Intensity;
	vec3 Color;
	float Range;
	vec3 Direction;  // the direction the light travels
	float CosOuter;
	float CosInner;
	float ShadowIndex; // the light's layer in u_SpotShadowMaps, -1: no shadows
	float Padding1;    // floats, not a vector: a std140 vec2 / vec3 would be aligned (and move the fields)
	float Padding2;
};

layout (std140, set = 0, binding = 1) uniform SceneData
{
	vec3 u_CameraPosition;    // offset 0
	float u_EnvMapRotation;   // offset 12: degrees around Y, applied to the environment lookups
	// The water volume the meshes are seen through in this pass (Include/WaterVolume.glslh). Off in the scene pass (there
	// a full-screen pass adds it, WaterFog.glsl); on in the water's reflection pass under the water, whose mirrored camera
	// is above the surface: the water its rays cross is the way from the surface down to the mirrored mesh.
	// The scene's water (z = 1 when it has one) is set in every pass: the light under it (the sun bent and dimmed on its
	// way down, the caustics) lights the meshes there.
	vec4 u_WaterVolumeBounds;     // offset 16: the water rectangle: center x, center z, half size x, half size z
	vec4 u_WaterVolumeParams;     // offset 32: x = the water height, y = 1 when the volume is on, z = 1 when the scene has water,
	                              // w = the rectangle's turn around Y (radians)
	vec4 u_WaterVolumeAbsorption; // offset 48: rgb, per meter
	vec4 u_WaterVolumeScatter;    // offset 64: rgb, the water's scatter color
	vec4 u_CausticsRegion;        // offset 80: the caustics map (u_CausticsMap): xy = its corner (min x, min z), z = 1 / its size, w = 1 / fade width (map units)
	vec4 u_CausticsParams;        // offset 96: x = strength (0 = no caustics this frame), y = the focus depth (meters)
	vec4 u_DisplayTone;           // offset 112: x = the exposure the view's composite applies, y = its hue preservation (Display surfaces)
};
layout (set = 0, binding = 2) uniform textureCube u_EnvRadianceTex;
#define u_EnvRadianceTex samplerCube(u_EnvRadianceTex, s_LinearRepeat)
layout (set = 0, binding = 3) uniform textureCube u_EnvIrradianceTex;
#define u_EnvIrradianceTex samplerCube(u_EnvIrradianceTex, s_LinearRepeat)
layout (set = 0, binding = 4) uniform texture2D u_BRDFLUTTexture;
#define u_BRDFLUTTexture sampler2D(u_BRDFLUTTexture, s_LinearRepeat)
layout (std140, set = 0, binding = 5) uniform Lights
{
	DirectionalLight u_Sun;                    // offset 0 (32 bytes)
	int u_PointLightCount;                     // offset 32
	int u_SpotLightCount;                      // offset 36
	ivec2 u_LightsPadding;                     // offset 40
	PointLight u_PointLights[MaxPointLights];  // offset 48 (48 bytes each)
	SpotLight u_SpotLights[MaxSpotLights];     // offset 816 (64 bytes each)
};
// The sun's cascaded shadow map (EnvMapVulkanShadows.h): a layer per cascade, compared in the sampler (1 lit, 0 shadow)
layout (set = 0, binding = 6) uniform texture2DArray u_ShadowMap;
#define u_ShadowMap sampler2DArrayShadow(u_ShadowMap, s_ShadowCompare)
layout (std140, set = 0, binding = 7) uniform Shadows
{
	mat4 u_CascadeViewProjection[4]; // offset 0: world -> shadow map clip space, per cascade
	vec4 u_CascadeSplits;            // offset 256: where each cascade ends (distance along the camera's view direction)
	vec4 u_CascadeTexelSizes;        // offset 272: world size of a shadow map texel, per cascade
	vec3 u_CameraForward;            // offset 288
	float u_ShadowsEnabled;          // offset 300: 0 = no shadows this frame
	float u_NormalBias;              // offset 304: in texels
	float u_ShadowSoftness;          // offset 308: PCF tap spacing in texels
	float u_ShowCascades;            // offset 312: 1 = tint the scene by cascade
	float u_ShadowMapTexelSize;      // offset 316: 1 / resolution (texture coordinate units)
	// Spot and point light shadows (a slot per shadowed light, see the lights' ShadowIndex)
	mat4 u_SpotShadowViewProjection[4]; // offset 320: world -> spot shadow map clip space
	vec4 u_PointShadowDepthParams[4];   // offset 576: depth = x - y / z (z: largest coordinate of the offset from the light)
	vec4 u_SpotShadowTanHalfFov;        // offset 640: tan(field of view / 2) of each spot slot
	vec4 u_LocalShadowParams;           // offset 656: normal bias (texels), softness (texels), 1 / spot resolution, 1 / point resolution
	vec4 u_ShadowDebug;                 // offset 672: xy = Shadows Only view, see ShadowDebugValue; z = the lighting shown:
	                                    // 1 the direct light only, 2 the indirect light only, 3 diffuse surface shading
	                                    // (ShadeSurfaceDiffuse from the material buffer), 4 the probes' irradiance only,
	                                    // 5 how much of the environment's reflection the probes let through, 6 the ambient
	                                    // occlusion image, 7 the ray-traced reflection image; 0: all of it
};
layout (set = 0, binding = 8) uniform texture2DArray u_SpotShadowMaps;  // a layer per shadowed spot light
#define u_SpotShadowMaps sampler2DArrayShadow(u_SpotShadowMaps, s_ShadowCompare)
layout (set = 0, binding = 9) uniform textureCubeArray u_PointShadowMaps; // a cube per shadowed point light
#define u_PointShadowMaps samplerCubeArrayShadow(u_PointShadowMaps, s_ShadowCompare)
// The light the waves focus under the water (WaterCaustics.glsl): 1 = the light of a flat surface
layout (set = 0, binding = 10) uniform texture2D u_CausticsMap;
#define u_CausticsMap sampler2D(u_CausticsMap, s_LinearClamp)

// The probe volume (EnvMapVulkanProbes, read with Include/Probes.glslh): a grid of points that each hold the light
// arriving there from every direction. The atlases have a tile per probe (see Include/ProbeOctahedral.glslh).
layout (set = 0, binding = 11) uniform texture2D u_ProbeIrradiance; // rgb: the irradiance / pi, to the power 1 / gamma
#define u_ProbeIrradiance sampler2D(u_ProbeIrradiance, s_LinearClamp)
layout (set = 0, binding = 12) uniform texture2D u_ProbeVisibility; // r: how far the probe sees in a direction (mean), g: mean of its square
#define u_ProbeVisibility sampler2D(u_ProbeVisibility, s_LinearClamp)
layout (std140, set = 0, binding = 13) uniform ProbeVolume
{
	vec4 u_ProbeOrigin;     // offset 0:  xyz = the position of probe (0, 0, 0), the volume's lowest corner; w = 1 when the
	                        //            probes light the scene (0: the environment does, as without a probe volume)
	vec4 u_ProbeSpacing;    // offset 16: xyz = from a probe to its neighbors; w = the irradiance encoding gamma
	ivec4 u_ProbeCounts;    // offset 32: xyz = probes along each axis
	vec4 u_ProbeBiases;     // offset 48: x = normal bias, y = view bias (fractions of the smallest spacing); z = 1 when the
	                        // probes darken the environment's reflection (EnvironmentVisibility in Include/ShadeSurface.glslh)
	vec4 u_ProbeAtlasSizes; // offset 64: xy = the irradiance atlas in texels, zw = the visibility atlas
};
layout (set = 0, binding = 14) uniform texture2D u_ProbeData;       // a texel per probe: xyz = its offset from the grid, w = 1 in use
#define u_ProbeData sampler2D(u_ProbeData, s_NearestClamp)

// The ambient occlusion (EnvMapVulkanSSAO): a value per pixel of the viewport, 1 = the light from all around reaches the
// surface, 0 = the geometry close to it lets none through. For the indirect light only. A set 0 of a pass that has no
// ambient occlusion (the water's reflection) holds a white texel here.
layout (set = 0, binding = 15) uniform texture2D u_AOImage;
#define u_AOImage sampler2D(u_AOImage, s_NearestClamp)

// The ray-traced reflections (EnvMapVulkanReflections): per pixel of the viewport, rgb = the light the surface reflects,
// a = how much of it replaces the environment's reflection (0: none was traced there). A set 0 of a pass that has no
// reflections (the water's reflection), and every set 0 without ray tracing, holds an empty texel here.
layout (set = 0, binding = 16) uniform texture2D u_ReflectionImage;
#define u_ReflectionImage sampler2D(u_ReflectionImage, s_NearestClamp)

// The materials of the Material Library as plain values, one entry per material (EnvMapVulkanMaterialBuffer): what a
// shader needs to know of a material it has no descriptor set for (set 1 holds one material's maps). A draw's entry is
// u_MaterialUniforms.MaterialIndex.
#include "GPUMaterial.glslh"
layout (std430, set = 0, binding = 17) readonly buffer Materials
{
	GPUMaterial u_Materials[];
};

// The BRDF lookup table for the environment's reflections: x = scale, y = bias of F0 (the texture was made for a gloss
// model: its v axis is 1 - roughness). Read between the centers of its outermost texels: its sampler repeats,
// so at the very edge linear filtering would mix in the opposite edge. At NdotV = 1 (a surface seen head-on) that is
// the grazing angle's strong reflection, a bright disc on whatever faces the camera.
vec2 SampleBRDFLUT(float NdotV, float roughness)
{
	vec2 halfTexel = 0.5 / vec2(textureSize(u_BRDFLUTTexture, 0));
	return texture(u_BRDFLUTTexture, clamp(vec2(NdotV, 1.0 - roughness), halfTexel, 1.0 - halfTexel)).rg;
}

#endif
