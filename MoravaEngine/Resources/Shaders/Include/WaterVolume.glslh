// The water volume along a view ray: how much water a ray crosses and what that water does to the light (SceneEnvMapVulkan).
// The water is everything under its surface (height) inside its rectangle (bounds: center x, center z, half size x,
// half size z); it has no bottom: the scene ends the ray. Used by the water shaders (Include/WaterCommon.glslh, with the
// water's own settings) and by the PBR shaders (with the per-frame u_WaterVolume* values, see Include/FrameSet.glslh).
// Needs Include/FrameSet.glslh (the sun, the environment).
#ifndef WATER_VOLUME_GLSLH
#define WATER_VOLUME_GLSLH

const float WaterIndexOfRefraction = 1.33;
const float WaterForwardScattering = 0.75; // Henyey-Greenstein g: water scatters light mostly forward

// The part of the ray origin + t * direction (0 <= t <= tMax) inside the water; false when the ray misses it
bool WaterVolumeSegment(vec3 origin, vec3 direction, float tMax, float height, vec4 bounds, out float t0, out float t1)
{
	t0 = 0.0;
	t1 = tMax;
	if (abs(direction.y) < 1e-6)
	{
		if (origin.y > height) return false;
	}
	else
	{
		float tSurface = (height - origin.y) / direction.y;
		if (direction.y > 0.0) t1 = min(t1, tSurface); else t0 = max(t0, tSurface);
	}
	for (int axis = 0; axis < 2; axis++)
	{
		float o = axis == 0 ? origin.x : origin.z;
		float d = axis == 0 ? direction.x : direction.z;
		float center = axis == 0 ? bounds.x : bounds.y;
		float halfSize = axis == 0 ? bounds.z : bounds.w;
		if (abs(d) < 1e-6)
		{
			if (abs(o - center) > halfSize) return false;
		}
		else
		{
			float ta = (center - halfSize - o) / d;
			float tb = (center + halfSize - o) / d;
			t0 = max(t0, min(ta, tb));
			t1 = min(t1, max(ta, tb));
		}
	}
	return t1 > t0;
}

// Sunlight in the water: the direction it travels after the (flat) surface bends it toward the vertical, and the part of
// it the surface lets in (Schlick Fresnel: a low sun is mostly reflected)
vec3 WaterSunTravelDirection()
{
	return refract(-u_Sun.Direction, vec3(0.0, 1.0, 0.0), 1.0 / WaterIndexOfRefraction);
}

float WaterSunEntering()
{
	float cosTheta = clamp(u_Sun.Direction.y, 0.0, 1.0);
	return 1.0 - (0.02 + 0.98 * pow(1.0 - cosTheta, 5.0));
}

// The caustics at a point depth meters under the surface, lit by sunlight traveling in direction travel: the light the
// waves focus there, relative to a flat surface (1). The map (WaterCaustics.glsl) is laid out by where the sun's ray
// entered the water; it fades out at its edges and over the first part of the focus depth (right under the surface the
// rays haven't gathered yet).
float WaterCaustics(vec3 position, vec3 travel, float depth)
{
	float strength = u_CausticsParams.x;
	if (strength <= 0.0)
	{
		return 1.0;
	}
	vec2 entry = position.xz - travel.xz * (depth / max(-travel.y, 0.05));
	vec2 uv = (entry - u_CausticsRegion.xy) * u_CausticsRegion.z;
	vec2 edge = min(uv, 1.0 - uv);
	float fade = clamp(min(edge.x, edge.y) * u_CausticsRegion.w, 0.0, 1.0) * clamp(depth / u_CausticsParams.y, 0.0, 1.0);
	// A 3x3 tent filter (four bilinear lookups between the texels): softens the single texels where the rays meet in a point
	vec2 texel = 0.5 / vec2(textureSize(u_CausticsMap, 0));
	float light = 0.25 * (texture(u_CausticsMap, uv + vec2(-texel.x, -texel.y)).r + texture(u_CausticsMap, uv + vec2(texel.x, -texel.y)).r +
		texture(u_CausticsMap, uv + vec2(-texel.x, texel.y)).r + texture(u_CausticsMap, uv + vec2(texel.x, texel.y)).r);
	return max(mix(1.0, light, strength * fade), 0.0);
}

// How deep a point is under the scene's water: false above the water or outside its rectangle (or with no water)
bool WaterDepthAt(vec3 position, out float depth)
{
	depth = u_WaterVolumeParams.x - position.y;
	vec4 bounds = u_WaterVolumeBounds;
	return u_WaterVolumeParams.z > 0.5 && depth > 0.0 && abs(position.x - bounds.x) <= bounds.z && abs(position.z - bounds.y) <= bounds.w;
}

// The sun under the water, at a point there: the direction its light comes from (bent toward the vertical by the
// surface) and the part of it left there: what the surface lets in, dimmed on the slanted way down (Beer-Lambert),
// gathered and spread by the waves (caustics). False where the point isn't under the water (the sun as it is: GLSL
// copies out parameters back even when they aren't written, so they always get a value).
bool WaterSunlightAt(vec3 position, out vec3 lightDirection, out vec3 transmittance)
{
	lightDirection = u_Sun.Direction;
	transmittance = vec3(1.0);
	float depth;
	if (!WaterDepthAt(position, depth))
	{
		return false;
	}
	if (u_Sun.Direction.y <= 0.0)
	{
		transmittance = vec3(0.0); // the sun is below the horizon: none of its light gets into the water
		return true;
	}
	vec3 travel = WaterSunTravelDirection();
	lightDirection = -travel;
	float path = depth / max(-travel.y, 0.05);
	transmittance = WaterSunEntering() * exp(-u_WaterVolumeAbsorption.rgb * path) * WaterCaustics(position, travel, depth);
	return true;
}

// The sky's light under the water, at a point there: dimmed by the water above it (1 where the point isn't under the water)
vec3 WaterSkylightAt(vec3 position)
{
	float depth;
	return WaterDepthAt(position, depth) ? exp(-u_WaterVolumeAbsorption.rgb * depth) : vec3(1.0);
}

// Henyey-Greenstein phase function, times 4 pi (1 on average over all directions)
float WaterPhase(float cosTheta)
{
	const float g = WaterForwardScattering;
	return (1.0 - g * g) / pow(max(1.0 + g * g - 2.0 * g * cosTheta, 1e-4), 1.5);
}

// The light the water scatters toward the viewer at a depth under the surface: sky and sun light, scattered by the water
// body (its scatter color), dimmed by the water above that point. viewDirection: where the viewer looks (the scattered
// light travels back along it); the sun's light is scattered mostly forward, so the water glows toward the sun.
vec3 WaterVolumeLightToward(float depthBelowSurface, vec3 scatterColor, vec3 absorption, vec3 viewDirection)
{
	depthBelowSurface = max(depthBelowSurface, 0.0);
	// The sky's light from straight up (the environment rotation turns around the vertical: it doesn't change this lookup)
	vec3 light = texture(u_EnvIrradianceTex, vec3(0.0, 1.0, 0.0)).rgb * exp(-absorption * depthBelowSurface);
	if (u_Sun.Intensity > 0.0 && u_Sun.Direction.y > 0.0)
	{
		vec3 sunTravel = WaterSunTravelDirection();
		float sunPath = depthBelowSurface / max(-sunTravel.y, 0.05); // the slanted way down from the surface
		light += u_Sun.Color * u_Sun.Intensity * WaterSunEntering() * WaterPhase(dot(sunTravel, -viewDirection)) * exp(-absorption * sunPath);
	}
	return scatterColor * light;
}

// The same without a view direction (the sun's light counted as scattered evenly)
vec3 WaterVolumeLight(float depthBelowSurface, vec3 scatterColor, vec3 absorption)
{
	depthBelowSurface = max(depthBelowSurface, 0.0);
	vec3 light = texture(u_EnvIrradianceTex, vec3(0.0, 1.0, 0.0)).rgb;
	if (u_Sun.Intensity > 0.0 && u_Sun.Direction.y > 0.0)
	{
		light += u_Sun.Color * u_Sun.Intensity * WaterSunEntering();
	}
	return scatterColor * light * exp(-absorption * depthBelowSurface);
}

// What is seen at distance tMax along the ray, through the water the ray crosses: its light is absorbed along the way
// (Beer-Lambert) and the water's scattered light takes its place (lit as at the middle of the path's depth)
vec3 ApplyWaterVolumeTo(vec3 color, vec3 origin, vec3 direction, float tMax, float height, vec4 bounds, vec3 absorption, vec3 scatterColor)
{
	float t0, t1;
	if (!WaterVolumeSegment(origin, direction, tMax, height, bounds, t0, t1))
	{
		return color;
	}
	vec3 transmittance = exp(-absorption * (t1 - t0));
	float middleY = origin.y + direction.y * 0.5 * (t0 + t1);
	return color * transmittance + WaterVolumeLightToward(height - middleY, scatterColor, absorption, direction) * (1.0 - transmittance);
}

#endif
