Scene:
  Version: 1
  Name: MainMenu
EditorCamera:
  Translation: [30, 14, 30]
  Rotation: [20, 45, 0]
  FieldOfView: 60
RenderSettings:
  Shadows:
    Distance: 40
    Resolution: 2048
    SplitLambda: 0.75
    Softness: 1
    DepthBias: 1.25
    SlopeBias: 1.75
    NormalBias: 1
  LocalShadows:
    SpotResolution: 1024
    PointResolution: 512
    Softness: 1
    DepthBias: 1.25
    SlopeBias: 1.75
    NormalBias: 1
  RayTracing:
    Enabled: true
  Reflections:
    Enabled: true
    MaxRoughness: 0.5
    Denoise: true
    Temporal: true
    HalfResolution: true
  AmbientOcclusion:
    Enabled: true
    Radius: 0.5
    Power: 1.5
    Falloff: 0.6
    Slices: 2
    Steps: 8
    Denoise: true
    Temporal: true
    HalfResolution: true
    RayTraced: true
    Rays: 2
  Antialiasing: SMAA
  Bloom:
    Enabled: true
    Threshold: 1
    Knee: 0.1
    UpsampleScale: 1
    Intensity: 1
    DirtEnabled: false
    DirtIntensity: 1
