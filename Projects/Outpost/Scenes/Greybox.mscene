Scene:
  Version: 1
  Name: Greybox
EditorCamera:
  Translation: [18, 14, 26]
  Rotation: [25, 35, 0]
  FieldOfView: 60
RenderSettings:
  Antialiasing: SMAA
Entities:
  - ID: 1001
    Name: Camera
    Parent: 0
    Transform:
      Translation: [0, 1.7, 16]
      Rotation: [5, 0, 0]
      Scale: [1, 1, 1]
    Camera:
      Primary: true
      FieldOfView: 70
      NearClip: 0.05
      FarClip: 1000
    Script:
      Class: Outpost.FlyCamera
      Fields:
        Speed: {Float: 6}
        StartActive: {Bool: false}
  - ID: 1100
    Name: Player
    Parent: 0
    Transform:
      Translation: [0, 0, 16]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    CharacterController:
      Height: 1.8
      Radius: 0.35
      Offset: [0, 0.9, 0]
      MaxSlopeDegrees: 45
      StepHeight: 0.35
      Mass: 80
      PushStrength: 100
    Script:
      Class: Outpost.Player
      Fields:
        Camera: {Entity: 1001}
        Body: {Entity: 1101}
        BodyGun: {Entity: 1104}
        ViewModel: {Entity: 1102}
        ViewModelGun: {Entity: 1103}
