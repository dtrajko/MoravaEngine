# The first person's arms (Shooter plan, Phase 1.3, the view model: E2): the soldier's arms (Soldier_Player_Arms.gltf, the
# body's rig) holding the placeholder rifle as the body's aim pose does (our own clip, Tools/CharacterPoses/make_rifle_poses.py).
# Phase 2 brings the weapons' own clips (idle, fire, reload) and the gun on the hand's bone (E3).
Animator:
  Version: 1
  Entry: Aim
  States:
    - Name: Aim
      Clip: {File: Assets/Models/SoldierAnimations/Soldier_Rifles.glb, Name: Rifle_Aim_Neutral}
      Speed: 1
      Loop: true
      InPlace: true
