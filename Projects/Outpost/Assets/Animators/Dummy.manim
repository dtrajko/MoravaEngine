# A training dummy (Shooter plan, Phase 2.2): standing, flinching at a hit (the head's or the chest's), falling when its
# health is gone, getting up again (Phase 2.4: Tools/CharacterPoses/make_get_up.py). Dummy.cs picks the state
# (Animator.Play), so there are no transitions. Death and GetUp play without In Place: the body falls back as the clip
# has it (its feet stay where it stood) and gets up from there to Idle's stance.
Animator:
  Version: 1
  Entry: Idle
  States:
    - Name: Idle
      Clip: {File: Assets/Models/QuaterniusAnimations/UAL1_Standard.glb, Name: Idle_Loop}
      Speed: 1
      Loop: true
      InPlace: true
    - Name: HitChest
      Clip: {File: Assets/Models/QuaterniusAnimations/UAL1_Standard.glb, Name: Hit_Chest}
      Speed: 1
      Loop: false
      InPlace: true
    - Name: HitHead
      Clip: {File: Assets/Models/QuaterniusAnimations/UAL1_Standard.glb, Name: Hit_Head}
      Speed: 1
      Loop: false
      InPlace: true
    - Name: Death
      Clip: {File: Assets/Models/QuaterniusAnimations/UAL1_Standard.glb, Name: Death01}
      Speed: 1
      Loop: false
      InPlace: false
    - Name: GetUp
      Clip: {File: Assets/Models/SoldierAnimations/Soldier_GetUp.glb, Name: Get_Up}
      Speed: 1
      Loop: false
      InPlace: false
  Transitions: []
