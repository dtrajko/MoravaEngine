      SuspensionDamping: 0.6
      AntiRollBars: true
      MaxTilt: 60
      CenterOfMassOffset: [0, -0.4, 0]
      FrontGrip: 1.3
      RearGrip: 1.4
      TopSpeed: 100
      ShiftTime: 0.15
      ShiftUpRpm: 5600
      Wheels:
        - {Entity: 2012, Position: [-1.05, 0, -1.28], Radius: 0.6, Width: 0.9, Steers: true, Driven: true, Handbrake: false}
        - {Entity: 2013, Position: [1.05, 0, -1.28], Radius: 0.6, Width: 0.9, Steers: true, Driven: true, Handbrake: false}
        - {Entity: 2014, Position: [-1.14, 0, 1.76], Radius: 0.6, Width: 1.08, Steers: false, Driven: true, Handbrake: true}
        - {Entity: 2015, Position: [1.14, 0, 1.76], Radius: 0.6, Width: 1.08, Steers: false, Driven: true, Handbrake: true}
