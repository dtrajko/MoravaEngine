      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    Model:
      File: Assets/Models/Track_TestTrack_Structure.glb
  - ID: 2001
    Name: Car
    Parent: 0
    Transform:
      Translation: [0.36, 49.8, 102]
      Rotation: [0, 3, 0]
      Scale: [1, 1, 1]
    Collider:
      Shape: Box
      Offset: [0, 0.1, 0]
      HalfExtents: [1.65, 0.42, 2.55]
