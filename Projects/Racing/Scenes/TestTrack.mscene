      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
  - ID: 3001
    Name: Road
    Parent: 3000
    Transform:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    Model:
      File: Assets/Models/Track_TestTrack_Road.glb
    Collider:
      Shape: TriangleMesh
      Friction: 1
      Restitution: 0
      IsTrigger: false
  - ID: 3002
    Name: Walls
    Parent: 3000
    Transform:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
