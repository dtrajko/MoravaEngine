Scene:
  Version: 1
  Name: TestTrack
EditorCamera:
  Translation: [60, 105, 160]
  Rotation: [20, 30, 0]
  FieldOfView: 60
Entities:
  - ID: 1001
    Name: Camera
    Parent: 0
    Transform:
      Translation: [0.4, 52, 108.5]
      Rotation: [12, 3, 0]
      Scale: [1, 1, 1]
    Camera:
      Primary: true
      FieldOfView: 65
      NearClip: 0.1
      FarClip: 3000
    Script:
      Class: Racing.VehicleCamera
      Fields:
        Target: {Entity: 2001}
        Distance: {Float: 9}
        Height: {Float: 1.6}
        MinDistance: {Float: 5}
        MaxDistance: {Float: 18}
  - ID: 1002
    Name: Environment
    Parent: 0
    Transform:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    Environment:
      File: Textures/HDR/citrus_orchard_road_2k.hdr
      Rotation: 4
      Exposure: 1
      AutoExposure: true
      HuePreservation: 0.5
      ExtractSun: true
      SkyboxLod: 0
  - ID: 1003
    Name: Sun
    Parent: 0
    Transform:
      Translation: [0, 0, 0]
      Rotation: [-35, 30, 0]
      Scale: [1, 1, 1]
    Sun:
      Enabled: true
      Color: [1, 0.95, 0.85]
      Intensity: 1
      FollowEnvironmentRotation: false
      CastShadows: true
      IconPlaced: false
  - ID: 1004
    Name: Terrain
    Parent: 0
    Transform:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    Terrain:
      Seed: 12345
      Size: 1024
      FlatCenter: [-80, -25]
      FlatRadius: 290
      FlatBlend: 150
      LodTolerance: 2
      Layers:
        Sand: {ID: 5100000000000000002, File: Assets/Materials/Terrain_Sand.mmat}
        Grass: {ID: 5100000000000000001, File: Assets/Materials/Terrain_Grass.mmat}
        Rock: {ID: 5100000000000000003, File: Assets/Materials/Terrain_Rock.mmat}
  - ID: 3000
    Name: Track
    Parent: 0
