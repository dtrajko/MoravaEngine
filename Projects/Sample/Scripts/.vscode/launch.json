{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Morava Player",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build scripts",
      "program": "${workspaceFolder}/../../../build/Debug/MoravaPlayer",
      "windows": { "program": "${workspaceFolder}/../../../build/Debug/MoravaPlayer.exe" },
      "args": [ "--project", "${workspaceFolder}/../Sample.mproject" ],
      "cwd": "${workspaceFolder}/../../.."
    },
    {
      "name": "Morava Editor",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build scripts",
      "program": "${workspaceFolder}/../../../build/Debug/MoravaEngine",
      "windows": { "program": "${workspaceFolder}/../../../build/Debug/MoravaEngine.exe" },
      "args": [ "--project", "${workspaceFolder}/../Sample.mproject" ],
      "cwd": "${workspaceFolder}/../../.."
    },
    {
      "name": "Attach to the Morava editor",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
