Scene:
  Version: 1
  Name: End
EditorCamera:
  Translation: [24, 22, 14]
  Rotation: [35, 35, 0]
  FieldOfView: 45
RenderSettings:
  Shadows:
    Distance: 70
    Resolution: 2048
    SplitLambda: 0.75
    Softness: 1
    DepthBias: 1.25
    SlopeBias: 1.75
    NormalBias: 1
  LocalShadows:
    SpotResolution: 1024
    PointResolution: 512
    Softness: 1
    DepthBias: 1.25
    SlopeBias: 1.75
    NormalBias: 1
  RayTracing:
    Enabled: true
  Reflections:
    Enabled: true
    MaxRoughness: 0.5
    Denoise: true
    Temporal: true
    HalfResolution: true
  AmbientOcclusion:
    Enabled: true
    Radius: 0.5
    Power: 1.5
    Falloff: 0.6
    Slices: 2
    Steps: 8
    Denoise: true
    Temporal: true
    HalfResolution: true
    RayTraced: true
    Rays: 2
  Bloom:
    Enabled: true
    Threshold: 1
    Knee: 0.1
    UpsampleScale: 1
    Intensity: 1
    DirtEnabled: false
    DirtIntensity: 1
Entities:
  - ID: 4797481855757227527
    Name: Camera
    Parent: 0
    Transform:
      Translation: [0, 2, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 0.99999994, 0.99999994]
    Camera:
      Primary: true
      FieldOfView: 45
      NearClip: 0.01
      FarClip: 1000
    Script:
      Class: Sample.Spinner
      Fields:
        DegreesPerSecond: {Float: 4}
  - ID: 16040318626583559303
    Name: Environment
    Parent: 0
    Transform:
      Translation: [0, 0, 0]
      Rotation: [0, 0, 0]
      Scale: [1, 1, 1]
    Environment:
