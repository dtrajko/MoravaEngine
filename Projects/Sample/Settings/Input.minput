# The game's actions and their bindings (src/Input/InputMap.h lists the names of keys and gamepad controls)
Actions:
  - Name: Move          # Axis2D: x = right, y = forward
    Type: Axis2D
    Bindings:
      - { Composite: WASD, Up: W, Down: S, Left: A, Right: D }
      - { Composite: Arrows, Up: Up, Down: Down, Left: Left, Right: Right }
      - { Gamepad: LeftStick, DeadZone: 0.15 }
  - Name: Look          # Axis2D, a rate: degrees per second: the mouse turns the camera's view (CameraFollow, while the cursor is captured)
    Type: Axis2D
    Bindings:
      - { Mouse: Delta, Scale: 0.1 }
  - Name: Jump
    Type: Button
    Bindings: [ { Key: Space }, { Gamepad: A } ]
  - Name: Orbit         # Axis2D, degrees per second: turns the camera's view around the ball (CameraFollow)
    Type: Axis2D
    Bindings:
      - { Composite: QERF, Up: R, Down: F, Left: Q, Right: E, Scale: 120 }
      - { Gamepad: RightStick, Scale: 180, DeadZone: 0.15 }
  - Name: Zoom          # Axis1D, notches this frame (the D-pad: a notch at each press): the camera closer (the wheel turned away from you, up) or farther (CameraFollow)
    Type: Axis1D
    Bindings:
      - { Mouse: Wheel }
      - { Gamepad: DPadUp }
      - { Gamepad: DPadDown, Scale: -1 }
  - Name: SwitchCamera  # the next camera view: above, behind the ball, the ball's eyes
    Type: Button
    Bindings: [ { Key: C }, { Gamepad: Y } ]
  - Name: Use           # a character uses what is in front of it (AnimatedCharacter: the animator's Use trigger)
    Type: Button
    Bindings: [ { Key: Enter }, { Gamepad: X } ]
  - Name: Run           # held: a character runs instead of walking (AnimatedCharacter; a stick pushed all the way runs too)
    Type: Button
    Bindings: [ { Key: LeftShift }, { Key: RightShift }, { Gamepad: RightBumper }, { Gamepad: LeftThumb } ]
  - Name: Pause         # the pause menu opens or closes (PauseMenu)
    Type: Button
    Bindings: [ { Key: Escape }, { Gamepad: Start } ]
  - Name: Accelerate    # Axis1D, 0 to 1: a vehicle's throttle (the engine reads it for a vehicle with Controls: Player)
    Type: Axis1D
    Bindings: [ { Key: W }, { Key: Up }, { Gamepad: RightTrigger } ]
  - Name: Brake         # Axis1D, 0 to 1: a vehicle brakes, and once it stops, reverses
    Type: Axis1D
    Bindings: [ { Key: S }, { Key: Down }, { Gamepad: LeftTrigger } ]
  - Name: Steer         # Axis1D: -1 left, 1 right
    Type: Axis1D
    Bindings:
      - { Composite: AD, Negative: A, Positive: D }
      - { Composite: Arrows, Negative: Left, Positive: Right }
      - { Gamepad: LeftStickX, DeadZone: 0.15 }
  - Name: Handbrake     # held: a vehicle's handbrake (its rear wheels lock, the throttle lets go)
    Type: Button
    Bindings: [ { Key: Space }, { Gamepad: B } ]
  - Name: UI_Navigate   # Axis2D: the game UI's selection from button to button (the engine reads it)
    Type: Axis2D
    Bindings:
      - { Composite: Arrows, Up: Up, Down: Down, Left: Left, Right: Right }
      - { Gamepad: DPad }
      - { Gamepad: LeftStick, DeadZone: 0.15 }
  - Name: UI_Submit     # presses the game UI's selected button (the engine reads it)
    Type: Button
    Bindings: [ { Key: Enter }, { Gamepad: A } ]
