# The game's actions and their bindings (MoravaEngine/src/Input/InputMap.h lists the names of keys and gamepad controls)
Actions:
  - Name: Move          # Axis2D: x = right, y = forward
    Type: Axis2D
    Bindings:
      - { Composite: WASD, Up: W, Down: S, Left: A, Right: D }
      - { Composite: Arrows, Up: Up, Down: Down, Left: Left, Right: Right }
      - { Gamepad: LeftStick, DeadZone: 0.15 }
  - Name: Look          # Axis2D, a rate: degrees per second: the mouse turns the camera's view (CameraFollow, while the cursor is captured)
    Type: Axis2D
    Bindings:
      - { Mouse: Delta, Scale: 0.1 }
  - Name: Jump
    Type: Button
    Bindings: [ { Key: Space }, { Gamepad: A } ]
  - Name: Orbit         # Axis2D, degrees per second: turns the camera's view around the ball (CameraFollow)
    Type: Axis2D
    Bindings:
      - { Composite: QERF, Up: R, Down: F, Left: Q, Right: E, Scale: 120 }
      - { Gamepad: RightStick, Scale: 180, DeadZone: 0.15 }
  - Name: Zoom          # Axis1D, notches this frame: the camera closer (the wheel turned away from you) or farther (CameraFollow)
    Type: Axis1D
    Bindings:
      - { Mouse: Wheel }
  - Name: SwitchCamera  # the next camera view: above, behind the ball, the ball's eyes
    Type: Button
    Bindings: [ { Key: C }, { Gamepad: Y } ]
  - Name: Use           # a character uses what is in front of it (AnimatedCharacter: the animator's Use trigger)
    Type: Button
    Bindings: [ { Key: Enter }, { Gamepad: X } ]
  - Name: Run           # held: a character runs instead of walking (AnimatedCharacter)
    Type: Button
    Bindings: [ { Key: LeftShift }, { Key: RightShift }, { Gamepad: LeftThumb } ]
