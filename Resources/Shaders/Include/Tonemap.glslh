// Tonemapping of linear HDR light to the display's 0..1 range: the viewport composite (ViewportComposite.glsl) and the
// render textures' (RenderTextureComposite.glsl); and back, for surfaces that show display colors (Display surfaces)
#ifndef TONEMAP_GLSLH
#define TONEMAP_GLSLH

// ACES filmic tonemapping (Narkowicz fit, with its 0.6 pre-exposure), per channel
vec3 ACES(vec3 color)
{
	vec3 x = max(color, vec3(0.0)) * 0.6;
	return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

// Per channel, the brightest channel of a bright color reaches 1 first while the others keep rising, so a bright red
// light turns white at its center (as film does). The hue-preserving version tonemaps only the brightest channel and
// scales the whole color by the same factor: the ratios between the channels (hue and saturation) stay as lit.
// huePreservation: 0 per channel, 1 hue-preserving, mixed in between
vec3 Tonemap(vec3 color, float huePreservation)
{
	color = max(color, vec3(0.0));
	vec3 perChannel = ACES(color);
	float peak = max(color.r, max(color.g, color.b));
	vec3 huePreserving = peak > 0.0 ? color * (ACES(vec3(peak)).r / peak) : vec3(0.0);
	return mix(perChannel, huePreserving, clamp(huePreservation, 0.0, 1.0));
}

// The light ACES turns into y (0..1, per channel): the positive root of y (2.43 t^2 + 0.59 t + 0.14) = 2.51 t^2 + 0.03 t,
// t the pre-exposed light. y is kept below 0.98: ACES only reaches 1 for unbounded light
vec3 InverseACES(vec3 y)
{
	y = clamp(y, vec3(0.0), vec3(0.98));
	vec3 a = 2.43 * y - 2.51;
	vec3 b = 0.59 * y - 0.03;
	vec3 c = 0.14 * y;
	vec3 t = (-b - sqrt(max(b * b - 4.0 * a * c, vec3(0.0)))) / (2.0 * a);
	return max(t, vec3(0.0)) / 0.6;
}

// The light Tonemap turns into the color (linear, 0..1). Exact for a hue preservation of 0 or 1; in between, the mix of
// both inverses (close: the two curves differ little)
vec3 InverseTonemap(vec3 color, float huePreservation)
{
	color = max(color, vec3(0.0));
	vec3 perChannel = InverseACES(color);
	float peak = max(color.r, max(color.g, color.b));
	vec3 huePreserving = peak > 0.0 ? color * (InverseACES(vec3(peak)).r / peak) : vec3(0.0);
	return mix(perChannel, huePreserving, clamp(huePreservation, 0.0, 1.0));
}

#endif
