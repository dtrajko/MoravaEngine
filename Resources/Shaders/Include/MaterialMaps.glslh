// Set 1, per material: the PBR texture maps of an EnvMapVulkanMaterial (the PBR, glass and G-buffer prepass shaders).
// Textures without a sampler of their own, read through a macro of the same name with the shared repeating sampler
// (Include/Samplers.glslh), as the frame set's textures are (Include/FrameSet.glslh).
#ifndef MATERIAL_MAPS_GLSLH
#define MATERIAL_MAPS_GLSLH

#include "Samplers.glslh"

layout (set = 1, binding = 0) uniform texture2D u_AlbedoTexture;
#define u_AlbedoTexture sampler2D(u_AlbedoTexture, s_LinearRepeat)
layout (set = 1, binding = 1) uniform texture2D u_NormalTexture;
#define u_NormalTexture sampler2D(u_NormalTexture, s_LinearRepeat)
layout (set = 1, binding = 2) uniform texture2D u_MetalnessTexture;
#define u_MetalnessTexture sampler2D(u_MetalnessTexture, s_LinearRepeat)
layout (set = 1, binding = 3) uniform texture2D u_RoughnessTexture;
#define u_RoughnessTexture sampler2D(u_RoughnessTexture, s_LinearRepeat)
layout (set = 1, binding = 4) uniform texture2D u_EmissiveTexture;
#define u_EmissiveTexture sampler2D(u_EmissiveTexture, s_LinearRepeat)
layout (set = 1, binding = 5) uniform texture2D u_AOTexture;
#define u_AOTexture sampler2D(u_AOTexture, s_LinearRepeat)

#endif
