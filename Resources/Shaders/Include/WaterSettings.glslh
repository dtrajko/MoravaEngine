// The water's settings (EnvMapVulkanWater, WaterSettingsUB) and the Gerstner waves that move its surface. Included by the
// water shaders (Include/WaterCommon.glslh, set 1) in both stages, and by WaterCaustics.glsl, which defines
// WATER_SETTINGS_SET 0 (the block is in its own set 0 there, bound to the same buffer).
#ifndef WATER_SETTINGS_GLSLH
#define WATER_SETTINGS_GLSLH

#ifndef WATER_SETTINGS_SET
#define WATER_SETTINGS_SET 1
#endif

const int MaxGerstnerWaves = 4;

layout (std140, set = WATER_SETTINGS_SET, binding = 1) uniform WaterSettings
{
	vec4 u_WaveOffsets;     // offset 0: xy = normal map layer 1 offset, zw = layer 2 (in normal map tiles, scrolled every frame)
	vec3 u_ScatterColor;    // offset 16: the color of the light the water body sends back up (darker = deeper, clearer water)
	float u_Roughness;      // offset 28: of the surface (the sun highlight and the blur of the reflection)
	float u_WaveScale1;     // offset 32: world size of one tile of normal map layer 1
	float u_WaveScale2;     // offset 36: of layer 2
	float u_WaveStrength;   // offset 40: steepness of the waves (scales the normals' slope)
	float u_ReflectionStrength; // offset 44: multiplies the environment reflection (1 = physically based)
	vec4 u_DepthParams;     // offset 48: depth -> view space z: z = y / (depth * z - x); w = the water height
	vec3 u_Absorption;      // offset 64: per meter, per color
	float u_RefractionStrength; // offset 76: how much the waves bend the view into the water
	float u_EdgeSoftness;   // offset 80: meters of water over which the surface fades in
	float u_FoamAmount;     // offset 84: 0 = no foam
	float u_FoamWidth;      // offset 88: meters of water that get foam
	float u_PlanarReflection;     // offset 92: 1 = u_ReflectionTexture holds this frame's reflection
	float u_ReflectionDistortion; // offset 96: how much the waves bend the reflection
	float u_TransparencyFromBelow; // offset 100: 0 = physical Snell's window, 1 = the surface is see-through from below
	float u_WaterRotation;        // offset 104: the rectangle's turn around Y (radians)
	float u_SettingsPadding;      // offset 108
	mat4 u_InverseViewProjection; // offset 112: clip space -> world (the camera's), to rebuild positions from depth
	vec4 u_WaterBounds;           // offset 176: the water rectangle: center x, center z, half size x, half size z (turned by u_WaterRotation)
	vec4 u_GerstnerParams;        // offset 192: x = the number of Gerstner waves (0: a flat surface)
	// offset 208: per wave i, [2i] = direction x, direction z, wave number k (2 pi / wavelength), amplitude (meters);
	// [2i + 1] = phase (radians, advanced every frame), steepness Q (how far the surface moves toward the crests)
	vec4 u_GerstnerWaves[2 * MaxGerstnerWaves];
};

// Gerstner waves (Tessendorf, "Simulating Ocean Water"; GPU Gems 1, chapter 1): each wave moves every surface point on a
// circle: up and down, and toward the crest and back. The crests get sharp and the troughs wide, as on real water.
// restXZ: where the point is on the flat surface. Returns how far the waves move it.
vec3 GerstnerDisplacement(vec2 restXZ)
{
	vec3 offset = vec3(0.0);
	int count = min(int(u_GerstnerParams.x), MaxGerstnerWaves);
	for (int i = 0; i < count; i++)
	{
		vec4 wave = u_GerstnerWaves[2 * i];
		vec4 motion = u_GerstnerWaves[2 * i + 1];
		float theta = wave.z * dot(wave.xy, restXZ) + motion.x;
		offset.xz += motion.y * wave.w * wave.xy * cos(theta);
		offset.y += wave.w * sin(theta);
	}
	return offset;
}

// The tilt of the moved surface at the point that rests at restXZ: its normal's x and z over its y (0 where it's level)
vec2 GerstnerTilt(vec2 restXZ)
{
	vec2 horizontal = vec2(0.0);
	float up = 1.0;
	int count = min(int(u_GerstnerParams.x), MaxGerstnerWaves);
	for (int i = 0; i < count; i++)
	{
		vec4 wave = u_GerstnerWaves[2 * i];
		vec4 motion = u_GerstnerWaves[2 * i + 1];
		float theta = wave.z * dot(wave.xy, restXZ) + motion.x;
		float kA = wave.z * wave.w;
		horizontal -= wave.xy * kA * cos(theta);
		up -= motion.y * kA * sin(theta);
	}
	return horizontal / max(up, 0.1);
}

#endif
