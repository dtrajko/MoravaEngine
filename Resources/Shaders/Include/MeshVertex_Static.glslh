// The vertex stage of static meshes, shared by HazelPBR_Static.glsl and GBufferPrepass_Static.glsl. The scene pass tests
// its depth EQUAL against the prepass's, so both must compute bit-identical positions: one source, and gl_Position is
// invariant (the compiler may not optimize it differently in the two pipelines). With MESH_VERTEX_INSTANCED (the
// foliage's copies: Include/MeshInstance.glslh) the transform is the instance's, not the push constants'.

layout(location = 0) in vec3 a_Position;
layout(location = 1) in vec3 a_Normal;
layout(location = 2) in vec3 a_Tangent;
layout(location = 3) in vec3 a_Binormal;
layout(location = 4) in vec2 a_TexCoord;

#include "FrameCamera.glslh"
#include "MeshVertexOutput.glslh"
#include "MeshInstance.glslh"
#include "MeshVertexMotion.glslh"

layout (push_constant) uniform Transform
{
	mat4 u_Transform;
};

#ifdef MESH_VERTEX_INSTANCED
#define MESH_TRANSFORM a_InstanceTransform
#else
#define MESH_TRANSFORM u_Transform
#endif

layout (location = 0) out VertexOutput Output;
#ifdef MESH_VERTEX_INSTANCED
// The copy's cross-fade and debug tint (Include/MeshInstance.glslh): the instanced prepass dithers by the fade
// (Include/GBufferPrepass_Fragment.glslh), the instanced scene pass tints (Include/HazelPBR_Fragment.glslh)
layout (location = 12) flat out vec2 v_InstanceData;
#endif

invariant gl_Position;

void main()
{
	Output.WorldPosition = vec3(MESH_TRANSFORM * vec4(a_Position, 1.0));
	Output.Normal = mat3(MESH_TRANSFORM) * a_Normal;
#ifdef MESH_VERTEX_INSTANCED
	Output.TexCoord = InstanceTexCoord(a_TexCoord); // an impostor's card: its view's part of the atlases
#else
	Output.TexCoord = a_TexCoord;
#endif
	Output.WorldNormals = mat3(MESH_TRANSFORM) * mat3(a_Tangent, a_Binormal, a_Normal);
	Output.WorldTransform = mat3(MESH_TRANSFORM);
	Output.Binormal = a_Binormal;

	gl_Position = u_ViewProjectionMatrix * MESH_TRANSFORM * vec4(a_Position, 1.0);

#ifdef MESH_VERTEX_INSTANCED
	v_InstanceData = vec2(InstanceFade(), InstanceTint());
#endif
#ifdef MESH_VERTEX_MOTION
	v_ClipPosition = gl_Position;
	v_PreviousClipPosition = u_PreviousViewProjectionMatrix * a_PreviousTransform * vec4(a_Position, 1.0);
#endif
}
