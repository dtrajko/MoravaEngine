// How a probe stores a value per direction (docs/rendering/SSAO_GI_RayTracing_Guide.html, Phase C): the sphere of
// directions is projected onto an octahedron, which unfolds into a square with little distortion. Each probe has a small
// square tile in an atlas: its interior texels (8 x 8 irradiance, 16 x 16 visibility) and a one-texel border around them,
// which repeats the texels across the octahedron's seam so linear filtering works up to the tile's edge.
// No bindings: shared by the shaders that read the atlases (Include/Probes.glslh) and the passes that write them.
#ifndef PROBE_OCTAHEDRAL_GLSLH
#define PROBE_OCTAHEDRAL_GLSLH

const int ProbeIrradianceTexels = 8;  // interior texels per side of a probe's irradiance tile
const int ProbeVisibilityTexels = 16; // and of its visibility tile

vec2 SignNotZero(vec2 v)
{
	return vec2(v.x >= 0.0 ? 1.0 : -1.0, v.y >= 0.0 ? 1.0 : -1.0);
}

// A unit vector as a point of the square [-1, 1]^2
vec2 OctEncode(vec3 n)
{
	n /= abs(n.x) + abs(n.y) + abs(n.z);
	vec2 p = n.xy;
	if (n.z < 0.0)
	{
		p = (1.0 - abs(n.yx)) * SignNotZero(n.xy);
	}
	return p;
}

// A point of the square [-1, 1]^2 as a unit vector
vec3 OctDecode(vec2 p)
{
	vec3 n = vec3(p, 1.0 - abs(p.x) - abs(p.y));
	if (n.z < 0.0)
	{
		n.xy = (1.0 - abs(n.yx)) * SignNotZero(n.xy);
	}
	return normalize(n);
}

// The tile of a probe in an atlas, in tiles: the probes of a horizontal layer (i, j) side by side, the layers (k) in rows
ivec2 ProbeTile(ivec3 probe, ivec3 counts)
{
	return ivec2(probe.x + probe.y * counts.x, probe.z);
}

// The interior texel (1..interior on both axes) a tile's texel shows: itself, or for a border texel (0 or interior + 1)
// the interior texel across the octahedron's seam. Along an edge: the neighboring row or column, mirrored about the
// edge's middle; at a corner: the opposite interior corner.
ivec2 ProbeBorderSource(ivec2 texelInTile, int interior)
{
	const bool borderX = texelInTile.x == 0 || texelInTile.x == interior + 1;
	const bool borderY = texelInTile.y == 0 || texelInTile.y == interior + 1;
	if (borderX && borderY)
	{
		return ivec2(texelInTile.x == 0 ? interior : 1, texelInTile.y == 0 ? interior : 1);
	}
	if (borderX)
	{
		return ivec2(texelInTile.x == 0 ? 1 : interior, interior + 1 - texelInTile.y);
	}
	if (borderY)
	{
		return ivec2(interior + 1 - texelInTile.x, texelInTile.y == 0 ? 1 : interior);
	}
	return texelInTile;
}

// The direction an interior texel (1..interior) of a tile stands for: its center
vec3 ProbeTexelDirection(ivec2 interiorTexel, int interior)
{
	return OctDecode((vec2(interiorTexel) - 0.5) / float(interior) * 2.0 - 1.0);
}

#endif
