// A material of the Material Library as plain values: an entry of the material buffer (EnvMapVulkanMaterialBuffer), which
// is u_Materials in the per-frame set (Include/FrameSet.glslh) and u_RayTracingMaterials in the ray tracing set
// (Include/RayTracing.glslh). 80 bytes, std430: must match EnvMapVulkanMaterialBuffer::GPUMaterial.
#ifndef GPU_MATERIAL_GLSLH
#define GPU_MATERIAL_GLSLH

struct GPUMaterial
{
	vec4 AlbedoColor;       // rgb: the albedo color, or the average color of the albedo map when it is used
	vec4 Emissive;          // rgb: the average color of the emissive map * the emissive intensity (0 without the map)
	float Metalness;        // the value, or the map's average
	float Roughness;        // the value, or the map's average
	uint Flags;             // GPUMaterialFlag...
	// The maps the material uses, as elements of the array of all textures (u_Textures in Include/RayTracing.glslh), for
	// a shader that can reach any material: a ray hit. GPUMaterialNoMap: the material has the value above instead.
	uint AlbedoMapIndex;
	uint NormalMapIndex;
	uint RoughnessMapIndex;
	uint MetalnessMapIndex;
	uint EmissiveMapIndex;
	float Tiling;            // the texture coordinate scale the maps are read with
	float EmissiveIntensity; // multiplies the emissive map
	float IOR;               // glass: its index of refraction (a ray that passes through it: the path tracer)
	float Cutoff;            // cutout: the albedo map's alpha below which there is no surface (GPUMaterialFlagCutout)
};

const uint GPUMaterialNoMap = 0xFFFFFFFFu;
const uint GPUMaterialFlagGlass = 1u;
const uint GPUMaterialFlagMetalRoughPacked = 2u; // glTF: roughness in G, metalness in B of their map; otherwise both in R
const uint GPUMaterialFlagGlassSolid = 4u;       // glass: a solid body (light bends entering and leaving); otherwise thin
const uint GPUMaterialFlagCutout = 8u;           // opaque with holes where the albedo map's alpha is below Cutoff
const uint GPUMaterialFlagDisplay = 16u;         // a screen: its emissive map's colors as they are, not lit (HazelPBR_Fragment.glslh)
const uint GPUMaterialFlagFlipHorizontally = 32u; // every map read mirrored left-right (u -> 1 - u, before the tiling)

#endif
